#!/bin/bash
#PBS -N VJAX_W39B_SMC
#PBS -q gpu_long
#PBS -W group_list=s2458
#PBS -l select=1:ncpus=72:ngpus=1:mem=400gb:model=gh200
# 24 h wall: the gpu preset's SMC governor is 20 h, leaving ~4 h for build/compile,
# init, PPC and plots (2026-07-09 sweep-cost rework projects the ladder well inside it;
# an over-budget run still checkpoints every stage -- resume with RESUME=1).
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -m abe
#
# =============================================================================
# WASP-39b differentiable VULCAN-JAX -> ExoJax transmission retrieval on a
# NASA NAS GH200 node: adaptive-tempered SMC with a forward-mode-jvp MALA kernel
# against the real Carter & May (2024) NIRISS+G395H spectrum.
#
# Same node/env pattern as the working SWAMPE WASP-43b retrieval PBS and the
# VULCAN-JAX GPU benchmark PBS (shared conda env pyt2_8_gh, GH200 XLA knobs from
# the validated benchmark). This job is READ-ONLY on the environment: all pip
# installs live in the one-time tools/bootstrap_nas_env.pbs; the preflight here
# only VALIDATES (retrieval_framework.validate_env) and hard-fails with a
# pointer at the bootstrap if anything is missing or stale.
#
# Expected layout on /nobackup (git pull for code, scp/cp for data -- see CLAUDE.md):
#   ${PROJECT_ROOT}/VULCAN-JAX/                                  (chemistry repo)
#   ${PROJECT_ROOT}/vulcan-forward/                               (forward engine)
#   ${PROJECT_ROOT}/vulcan-retrieval/                             (THIS repo; data/ at its root)
#   ${PROJECT_ROOT}/vulcan-retrieval/runs/w39b_smc_retrieval/     (THIS case dir)
#   (the ExoMolOP k-tables and the H2-H2/H2-He CIA live in the repo data/;
#   validate_env names anything missing)
#
# Submit (from this case dir, or export PROJECT_ROOT):
#   cd /nobackup/$USER/VULCAN_W39b_HPC/vulcan-retrieval/runs/w39b_smc_retrieval
#   qsub run_nas_w39b.pbs                        # real-data production run
#   qsub -v SYNTH=1 run_nas_w39b.pbs             # gpu-fidelity synthetic recovery test
#   qsub -v CALIBRATE_ONLY=1 run_nas_w39b.pbs    # timing projection only (~1 h)
#   qsub -v CALIBRATE_COUNT_MAX=1 run_nas_w39b.pbs   # accept_count distribution only
#   qsub -v SAMPLER=nautilus run_nas_w39b.pbs       # nested sampling (run_nautilus.py)
#   qsub -v SAMPLER=nautilus,RESUME=1 run_nas_w39b.pbs   # continue it in the next job
#
# Env knobs (-v):
#   CONDA_ENV               interpreter env            (default pyt2_8_gh)
#   SMC_RETRIEVAL_PRESET    smoke | gpu | prod         (default gpu)
#   SMC_RETRIEVAL_OVERRIDES JSON Config overrides      (optional)
#   SMC_RETRIEVAL_OVERRIDES_FILE  JSON Config overrides file, relative to this dir (optional)
#   SEED=<int>              independent SMC seed in its own out_dir (data/<preset>_seed<N>).
#                           A SINGLE run's support-fraction error bar is NOT the
#                           uncertainty on logZ or on the marginals; run >= 3 seeds
#                           and quote the seed-to-seed spread (see the evidence_report
#                           docstring). RESUME=1 composes with it.
#   SYNTH=1                 inject-and-recover instead of fitting real data
#   CALIBRATE_ONLY=1        time 1 likelihood + 1 mutation sweep, project, exit
#   CALIBRATE_CHAIN=<file>  run several bounded arms (memory probes, calibrations,
#                           fixed-step benches) in ONE job, in order, each in its own
#                           subshell; a failing arm
#                           is recorded and the chain goes on. Path relative to this
#                           dir; format in overrides/speed_repair_chain.txt. Per-arm
#                           table: logs/chain_<jobid>.tsv, summary at the end of the log.
#     qsub -v CALIBRATE_CHAIN=overrides/speed_repair_chain.txt run_nas_w39b.pbs
#   CALIBRATE_COUNT_MAX=1   measure the real accept_count distribution (calibrate_count_max.py);
#                           CALIBRATE_N_DRAWS (default 48), CALIBRATE_COUNT_MAX_PROBE (default
#                           20000), CALIBRATE_SEED_OFFSET (default 0)
#                           CALIBRATE_FIXED_STEPS=<K> (+ CALIBRATE_GRAD=1, and only
#                           the value 1 enables it): fixed-step
#                           step-cost bench, primal or gradient; pair with NSYS=1
#                           NSYS_CAPTURE_API=1 NSYS_GPU_METRICS=1 for kernels per step
#                           CALIBRATE_LANES=<k>: run the cold batch on k lanes with
#                           refill (cfg.cold_lanes; the gpu preset's default is the
#                           device's SM count, 132 on the GH200; 0 = one lockstep batch, the reference
#                           arm) -- the lane-count arm of the bench, same draws and
#                           seed. A fixed-step bench runs lockstep on its own.
#   RESUME=1                continue a killed run from its smc_checkpoint.npz
#   XLA_CMDBUF=0            command buffers OFF (the empty flag). ON by default: the WHILE
#                           capture took the primal from ~255 to 132 ms per accepted step, jobs
#                           78991 (XLA's default set) vs 78995. Opt-OUT, so an A/B is one -v
#                           variable; the commas stay inside the script
#   XLA_CMDBUF=2            XLA's default command set PLUS WHILE and CONDITIONAL, and a
#                           one-command minimum graph size: the arm that shows whether
#                           the whole step loop is captured as one graph
#   NSYS=1                  WINDOWED Nsight Systems capture of a bounded slice (for the
#                           long SMC run): NSYS_DELAY (default 900 s, skips build+jit),
#                           NSYS_DURATION (default 120 s); job runs on past the window.
#   NSYS_CAPTURE_API=1      with NSYS=1: capture the range the app marks with
#                           cudaProfilerStart/Stop (run_smc --calibrate marks its timed
#                           mutation sweep) instead of a fixed delay window.
#   NSYS_FULL=1             FULL whole-process Nsight Systems trace (for a BOUNDED job:
#                           the count_max calibration or PROBE_MEMORY). Keep that job
#                           short or the .nsys-rep gets large.
#   NSYS_GPU_METRICS=1      add the GPU-metrics timeline to either mode (SM/DRAM
#                           utilization). NSYS_GPU_METRICS_DEV overrides the device
#                           list (default all); NSYS_GPU_METRICS_HZ the rate (1000)
#   VULCAN_SCRATCH          cache root                 (default /nobackup/$USER/.vulcan)
#
# Deep-adiabat sensitivity (the interior temperature is FIXED and transmission does
# not constrain it, while it does set the CO/CH4 quench points, so lnKzz inherits it):
#   qsub -v SEED=1,SMC_RETRIEVAL_OVERRIDES='{"tp_Tint_K": 100.0}' run_nas_w39b.pbs
#   qsub -v SEED=2,SMC_RETRIEVAL_OVERRIDES='{"tp_Tint_K": 300.0}' run_nas_w39b.pbs
# Report how far lnKzz and lnZ move against their own statistical widths.
#
# On a successful run the plots run automatically. Under smc_chem_mode="warm" so do the
# warm-vs-cold validation (validate_warm; PASS gate max|dlogL| < 0.1; the verdict lands
# in the log + validate_warm.npz) and mala_reversibility; the cold default needs neither.
#
# XLA A/B experiments (launch-overhead reduction; the GPU sits at ~300-390 W of 700 W,
# so the solver is launch-bound and per-step overhead, not arithmetic, is the speed lever).
# Judge purely by t_mutation_sweep_s in timing.json vs a baseline calibration:
#   qsub -v CALIBRATE_ONLY=1,XLA_FLAGS='--xla_gpu_enable_triton_gemm=false --xla_gpu_autotune_level=4' run_nas_w39b.pbs
#   qsub -v CALIBRATE_ONLY=1,XLA_CMDBUF=0 run_nas_w39b.pbs
#
# Live log:  tail -f <w39b_smc_retrieval>/logs/W39B_SMC_<jobid>.log
# =============================================================================
set -euo pipefail

# --- locate the project root (PBS spools the script; rely on PBS_O_WORKDIR) ---
if [ -n "${PROJECT_ROOT:-}" ]; then :
elif [ -n "${PBS_O_WORKDIR:-}" ] && [ -d "${PBS_O_WORKDIR}/vulcan-retrieval/runs/w39b_smc_retrieval" ]; then
  PROJECT_ROOT="${PBS_O_WORKDIR}"
elif [ -n "${PBS_O_WORKDIR:-}" ] && [ "$(basename "${PBS_O_WORKDIR}")" = "w39b_smc_retrieval" ]; then
  # case dir -> runs -> repo -> PROJECT_ROOT: three levels up
  PROJECT_ROOT="$(cd -- "${PBS_O_WORKDIR}/../../.." && pwd -P)"
else
  echo "ERROR: set PROJECT_ROOT or submit from .../vulcan-retrieval/runs/w39b_smc_retrieval"
  exit 1
fi
REPO_DIR="${PROJECT_ROOT}/vulcan-retrieval"                            # repo root (data/ lives here)
SMC_DIR="${REPO_DIR}/runs/w39b_smc_retrieval"         # this case
if [ ! -f "${SMC_DIR}/case.py" ] || [ ! -f "${REPO_DIR}/src/retrieval_framework/run_smc.py" ]; then
  echo "ERROR: case.py / retrieval framework not found under PROJECT_ROOT=${PROJECT_ROOT}"
  exit 1
fi
export PROJECT_ROOT
export VULCAN_PROJECT_ROOT="${PROJECT_ROOT}"   # makes forward/config.py portable

# --- stream everything to a tail-able log (PBS .o appears only at job end) ----
LOG_DIR="${SMC_DIR}/logs"
mkdir -p "${LOG_DIR}"
_jobid="${PBS_JOBID:-manual_$$}"
LOG_FILE="${LOG_DIR}/W39B_SMC_${_jobid%%.*}.log"
exec > >(tee -a "${LOG_FILE}") 2>&1
echo "Live log: tail -f ${LOG_FILE}"
echo "Job ${PBS_JOBID:-?} started $(date) on $(hostname) ($(uname -m))"
echo "PROJECT_ROOT=${PROJECT_ROOT}"

# --- NAS proxy (only for a download; validate_env requires the data on disk) --
export http_proxy="${HTTPS_PROXY:-${http_proxy:-http://proxy.nas.nasa.gov:3128}}"
export https_proxy="${http_proxy}" HTTP_PROXY="${http_proxy}" HTTPS_PROXY="${http_proxy}"

# --- caches off $HOME (scratch-rooted, shared with the bootstrap) -------------
: "${VULCAN_SCRATCH:=/nobackup/${USER}/.vulcan}"
export PIP_CACHE_DIR="${VULCAN_SCRATCH}/cache/pip"
export JAX_COMPILATION_CACHE_DIR="${JAX_COMPILATION_CACHE_DIR:-${VULCAN_SCRATCH}/cache/jax}"
# Log every compile and every persistent-cache hit (WARNING level), so a chained
# job's log shows whether it reused the last job's ~22 min gradient compiles:
# grep "Persistent compilation cache hit" in the second job's log.
export JAX_LOG_COMPILES="${JAX_LOG_COMPILES:-1}"
export XDG_CACHE_HOME="${VULCAN_SCRATCH}/cache/xdg"
export MPLCONFIGDIR="${VULCAN_SCRATCH}/cache/mpl"
export TMPDIR="${VULCAN_SCRATCH}/tmp"
mkdir -p "${PIP_CACHE_DIR}" "${JAX_COMPILATION_CACHE_DIR}" \
         "${XDG_CACHE_HOME}" "${MPLCONFIGDIR}" "${TMPDIR}"

# --- conda env (shared GH200 env; user site populated by the bootstrap) -------
module purge 2>/dev/null || true
module use -a /swbuild/analytix/tools/modulefiles 2>/dev/null || true
module load miniconda3/gh2 2>/dev/null || true
CONDA_BASE="$(conda info --base)"
# shellcheck disable=SC1091
source "${CONDA_BASE}/etc/profile.d/conda.sh"
conda activate "${CONDA_ENV:-pyt2_8_gh}"

# Per-interpreter userbase (matches tools/bootstrap_nas_env.pbs): a shared
# userbase's bin/ is not python-version-scoped, which is how the pre-2026-07
# flow got a dangling console script and a crashed in-job uninstall.
PYVER="$(python -c 'import sys; print("%d.%d" % sys.version_info[:2])')"
export PYTHONUSERBASE="${VULCAN_SCRATCH}/userbase-py${PYVER}"
unset PYTHONNOUSERSITE

# --- GPU runtime env (validated GH200 knobs from the VULCAN-JAX benchmark) ----
export PYTHONUNBUFFERED=1
export JAX_ENABLE_X64="${JAX_ENABLE_X64:-1}"
unset JAX_PLATFORMS
export JAX_PLATFORM_NAME=gpu
export XLA_PYTHON_CLIENT_PREALLOCATE="${XLA_PYTHON_CLIENT_PREALLOCATE:-true}"
export XLA_PYTHON_CLIENT_MEM_FRACTION="${XLA_PYTHON_CLIENT_MEM_FRACTION:-0.90}"
XLA_BASE_FLAGS="${XLA_FLAGS:---xla_gpu_enable_triton_gemm=false --xla_gpu_autotune_level=0}"
# Command buffers are the production default (they cut the primal loop from
# ~255 to 132 ms per accepted step); XLA_CMDBUF=0 turns them OFF for an A/B or a
# per-kernel profile. Off needs the EMPTY value: with no flag at all XLA keeps its
# own default set (checked on jaxlib 0.6.2: the optimized HLO still carries
# command_buffer computations), so the old "drop the flag" 0 was never off.
# The list in 1 REPLACES XLA's default set; the "+" form in 2 adds to it, and a
# while loop becomes one graph only if every op in its body is capturable.
# A function, so a chain arm that sets its own XLA_CMDBUF gets its own flags.
set_xla_flags() {
  case "${XLA_CMDBUF:-1}" in
    0) export XLA_FLAGS="${XLA_BASE_FLAGS} --xla_gpu_enable_command_buffer=" ;;
    1) export XLA_FLAGS="${XLA_BASE_FLAGS} --xla_gpu_enable_command_buffer=FUSION,CUBLAS,CUSTOM_CALL,WHILE" ;;
    2) export XLA_FLAGS="${XLA_BASE_FLAGS} --xla_gpu_enable_command_buffer=+WHILE,+CONDITIONAL --xla_gpu_graph_min_graph_size=1" ;;
    *) echo "ERROR: XLA_CMDBUF=${XLA_CMDBUF}: expected 0, 1 or 2"; return 1 ;;
  esac
}
set_xla_flags || exit 1
case "${SAMPLER:-smc}" in
  smc|nautilus) ;;
  *) echo "ERROR: SAMPLER=${SAMPLER}: expected smc or nautilus"; exit 1 ;;
esac
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
# Production solver: `ffi`, the CUDA block-Thomas kernel (the maintainer's
# decision, notes 2.13). Pinned here, not left to config_schema.choose_solver(),
# so the job script states the choice and a missing kernel build fails loudly
# instead of falling back to `fast`. A chain arm or `qsub -v VULCAN_JAX_SOLVER=fast`
# still overrides it.
export VULCAN_JAX_SOLVER="${VULCAN_JAX_SOLVER:-ffi}"

# --- preflight: GPU visible, JAX on it, packages + data present ---------------
if ! command -v nvidia-smi >/dev/null 2>&1 || ! nvidia-smi >/dev/null 2>&1; then
  echo "ERROR: no visible NVIDIA GPU in this job."; exit 1
fi
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader

# NO installs here (the pre-2026-07 per-job pip installs raced across concurrent
# jobs on the shared userbase and crashed mid-uninstall). Validate-only: every
# check the old inline preflight ran (packages editable + current, jax on GPU,
# data seeds, exogibbs) now lives in retrieval_framework.validate_env, shared
# verbatim with the bootstrap and runnable by hand on a front end.
python -u -m retrieval_framework.validate_env "${PROJECT_ROOT}" --require-gpu || {
  echo "ERROR: environment validation failed (or retrieval_framework is not installed)."
  echo "       One-time fix, then resubmit:"
  echo "  cd ${REPO_DIR}"
  echo "  qsub tools/bootstrap_nas_env.pbs"
  exit 1
}

# --- GPU utilization monitor ---------------------------------------------------
GPU_MON_LOG="${LOG_DIR}/gpu_monitor_${_jobid%%.*}.log"
( while true; do
    { echo "=== $(date '+%F %T') ==="
      # util%, W, MHz, MiB, MiB -- power+clocks distinguish real work from
      # launch-bound tiny kernels (100% util at ~160W = kernel-launch-bound)
      nvidia-smi --query-gpu=utilization.gpu,power.draw,clocks.sm,memory.used,memory.total --format=csv,noheader,nounits
    } >> "${GPU_MON_LOG}" 2>&1
    sleep 60
  done ) &
GPU_MON_PID=$!
cleanup() { kill "${GPU_MON_PID}" >/dev/null 2>&1 || true; }
trap cleanup EXIT
echo "GPU monitor: ${GPU_MON_LOG}"

# --- Nsight Systems profiling -------------------------------------------------
# Two modes -> logs/nsys_<jobid>.nsys-rep :
#   NSYS=1       WINDOWED: skip build+compile (NSYS_DELAY, default 900 s) then trace
#                NSYS_DURATION (default 120 s) of the steady-state GPU loop, --kill=none
#                so the job runs on. Use for the long (multi-hour) SMC run, where a
#                whole-run kernel trace would be tens of GB and unloadable.
#   NSYS_FULL=1  FULL whole-process trace, no window (runs start->finish). Use for a
#                BOUNDED job -- the count_max calibration or PROBE_MEMORY -- where the
#                whole thing is minutes-to-an-hour. Keep the traced job short (e.g.
#                calibrate at a modest CALIBRATE_COUNT_MAX_PROBE) or the .nsys-rep gets
#                large; the chemistry loop launches many tiny kernels.
# Either mode: NSYS_GPU_METRICS=1 adds the GPU-metrics timeline, a sampled SM/DRAM
#   hardware-counter timeline (the compact "how busy is the GPU, really" view that
#   answers the 100%-util-at-200 W launch-bound question directly). The flag spelling
#   changed across nsys versions (hardcoded below for the NAS nsys). The always-on
#   nvidia-smi monitor above already logs util/power/clocks every 60 s for the whole run.
# Inspect:  nsys stats -r cuda_gpu_kern_sum,cuda_gpu_mem_time_sum logs/nsys_<jobid>.nsys-rep
# or scp the .nsys-rep to a workstation and open it in the Nsight Systems GUI.
# build_nsys_wrap reads NSYS* from the CURRENT environment, so a chain arm can rebuild
# it after exporting its own knobs; NSYS_TAG suffixes the .nsys-rep name so two
# profiled arms in one job do not overwrite each other.
build_nsys_wrap() {
NSYS_WRAP=()
if [ "${NSYS:-0}" = "1" ] || [ "${NSYS_FULL:-0}" = "1" ]; then
  command -v nsys >/dev/null 2>&1 || module load cuda 2>/dev/null || true
  if ! command -v nsys >/dev/null 2>&1; then
    echo "ERROR: NSYS/NSYS_FULL set but nsys is not in PATH (and 'module load cuda' did not provide it)."
    exit 1
  fi
  NSYS_OUT="${LOG_DIR}/nsys_${_jobid%%.*}${NSYS_TAG:-}"
  NSYS_WRAP=(nsys profile -o "${NSYS_OUT}" --force-overwrite=true
             -t cuda,nvtx -s none --cpuctxsw=none)
  # Under command buffers XLA replays CUDA graphs, which nsys traces as ONE
  # unit per graph launch by default: the kernel table would then hold no
  # per-kernel rows for the step loop. Node-level tracing keeps them.
  if [ "${XLA_CMDBUF:-1}" != "0" ]; then
    NSYS_WRAP+=(--cuda-graph-trace=node)
  fi
  if [ "${NSYS_GPU_METRICS:-0}" = "1" ]; then
    # 1 kHz keeps the metrics stream small enough for a multi-hour full trace (10 kHz
    # over hours would be GBs); 10 ms resolution is plenty to see busy-vs-idle.
    # nsys >= 2024.5 spells this --gpu-metrics-devices (plural); the deprecated
    # singular is ignored with a warning and --gpu-metrics-frequency then aborts
    # nsys before Python launches (jobs 66201/66202). A help-text probe for the
    # plural spelling ALSO chose wrong on the compute nodes (66284-66289: the
    # node's `nsys profile --help` does not print the switch), so the spelling is
    # hardcoded for the NAS nsys (2025.6.3; documented values: GPU ID, all, none).
    # NSYS_GPU_METRICS_DEV overrides the device list at qsub time if a future nsys
    # changes syntax again -- no git round-trip needed.
    NSYS_WRAP+=(--gpu-metrics-devices="${NSYS_GPU_METRICS_DEV:-all}"
                --gpu-metrics-frequency="${NSYS_GPU_METRICS_HZ:-1000}")
    echo "nsys gpu-metrics: devices=${NSYS_GPU_METRICS_DEV:-all} frequency=${NSYS_GPU_METRICS_HZ:-1000} Hz"
  fi
  if [ "${NSYS_FULL:-0}" = "1" ]; then
    echo "nsys: FULL whole-process capture (gpu_metrics=${NSYS_GPU_METRICS:-0}) -> ${NSYS_OUT}.nsys-rep"
  elif [ "${NSYS_CAPTURE_API:-0}" = "1" ]; then
    # The app marks the range: run_smc --calibrate calls cudaProfilerStart/Stop
    # around its timed mutation sweep, so the capture lands on the sweep wherever
    # it falls (job 78814's fixed 3600 s window landed inside a 62-min init).
    NSYS_WRAP+=(--capture-range=cudaProfilerApi --capture-range-end=stop --kill=none)
    echo "nsys: CAPTURE-RANGE cudaProfilerApi (the timed sweep; gpu_metrics=${NSYS_GPU_METRICS:-0}) -> ${NSYS_OUT}.nsys-rep"
  else
    NSYS_WRAP+=(--delay="${NSYS_DELAY:-900}" --duration="${NSYS_DURATION:-120}" --kill=none)
    echo "nsys: WINDOWED delay=${NSYS_DELAY:-900}s duration=${NSYS_DURATION:-120}s (gpu_metrics=${NSYS_GPU_METRICS:-0}) -> ${NSYS_OUT}.nsys-rep"
  fi
  nsys --version | head -1 || true
fi
}
build_nsys_wrap

# --- retrieval configuration ---------------------------------------------------
export SMC_RETRIEVAL_PRESET="${SMC_RETRIEVAL_PRESET:-gpu}"
if [ "${RESUME:-0}" = "1" ]; then export SMC_RESUME=1; fi
if [ "${SYNTH:-0}" = "1" ] || [ -n "${SEED:-}" ]; then
  # SYNTH: gpu-fidelity synthetic injection/recovery run (do this once before
  # trusting the real-data posterior). SEED: a reproducible draw. Both MERGE
  # into whatever overrides are already set (a bash default cannot hold JSON:
  # its closing brace ends the expansion), and the output directory carries
  # both so synthetic seeds never overwrite each other.
  SMC_RETRIEVAL_OVERRIDES="$(python -c '
import json, os
d = json.loads(os.environ.get("SMC_RETRIEVAL_OVERRIDES") or "{}")
if os.environ.get("SYNTH", "0") == "1":
    d["generate_synthetic_data"] = True
if os.environ.get("SEED"):
    d["seed"] = int(os.environ["SEED"])
print(json.dumps(d))')"
  export SMC_RETRIEVAL_OVERRIDES
  if [ "${SYNTH:-0}" = "1" ]; then _od="${SMC_DIR}/data/gpu_synth"; else _od="${SMC_DIR}/data/${SMC_RETRIEVAL_PRESET}"; fi
  export SMC_RETRIEVAL_OUT_DIR="${SMC_RETRIEVAL_OUT_DIR:-${_od}${SEED:+_seed${SEED}}}"
fi
echo "preset=${SMC_RETRIEVAL_PRESET} overrides=${SMC_RETRIEVAL_OVERRIDES:-<none>}"

cd -P "${REPO_DIR}"   # stable cwd only; retrieval_framework is installed, imports need no cwd

# A windowed nsys (--kill=none) returns when its window closes and leaves the
# app running (job 78814); every path that may run under the wrapper waits for
# this tree's python before the next step touches the GPU or the job exits.
wait_for_tree_python() {
  while pgrep -u "${USER}" -f "retrieval_framework\.(run_smc|run_nautilus|probe_memory|calibrate_count_max) ${SMC_DIR}" >/dev/null; do
    sleep 30
  done
}

rc=0
if [ "${PROBE_MEMORY:-0}" = "1" ]; then
  # compile-only XLA buffer-size report for every evaluator stage; nothing
  # executes on the GPU, so this cannot OOM (see retrieval_framework/probe_memory.py)
  echo "========== MEMORY PROBE (compile-only) =========="
  ${NSYS_WRAP[@]+"${NSYS_WRAP[@]}"} python -u -m retrieval_framework.probe_memory "${SMC_DIR}" || rc=$?
  wait_for_tree_python
elif [ -n "${CALIBRATE_CHAIN:-}" ]; then
  # One job, several bounded arms. Each non-comment line of the chain file:
  #   name|probe, calibrate or bench|overrides file|out dir|KEY=VAL;KEY=VAL
  # (the overrides file may be empty; the last field is optional). A bench arm is
  # the fixed-step step-cost bench (calibrate_count_max --fixed-steps), sized by
  # its CALIBRATE_N_DRAWS (default: the preset's particle count, the GPU's SM
  # count), CALIBRATE_FIXED_STEPS (150) and CALIBRATE_GRAD.
  # An arm's XLA_CMDBUF rebuilds its XLA_FLAGS; VULCAN_JAX_SOLVER passes through.
  # Every override file is checked BEFORE the first arm runs (a missing one cost job 78648).
  # Arms run in order, each in a subshell that exports its own env; the chain file is read
  # on fd 3 so an arm's process cannot swallow the remaining lines.
  CHAIN_FILE="${SMC_DIR}/${CALIBRATE_CHAIN}"
  [ -f "${CHAIN_FILE}" ] || { echo "ERROR: chain file not found: ${CHAIN_FILE}"; exit 1; }
  CHAIN_TSV="${LOG_DIR}/chain_${_jobid%%.*}.tsv"
  echo "========== CALIBRATION CHAIN ${CHAIN_FILE} =========="
  while IFS='|' read -r -u 3 name mode ovf outd envs; do
    case "${name}" in ''|'#'*) continue ;; esac
    if [ -n "${ovf}" ] && [ ! -f "${SMC_DIR}/${ovf}" ]; then
      echo "ERROR: arm ${name}: missing override file ${SMC_DIR}/${ovf}"; exit 1
    fi
    case "${mode}" in probe|calibrate|bench) ;; *) echo "ERROR: arm ${name}: mode must be probe, calibrate or bench, got '${mode}'"; exit 1 ;; esac
  done 3< "${CHAIN_FILE}"
  printf 'arm\tmode\trc\tseconds\tout_dir\n' > "${CHAIN_TSV}"
  while IFS='|' read -r -u 3 name mode ovf outd envs; do
    case "${name}" in ''|'#'*) continue ;; esac
    echo "---------- arm ${name} (${mode}) started $(date) ----------"
    t0="$(date +%s)"; arm_rc=0
    (
      export SMC_RETRIEVAL_OUT_DIR="${outd}" NSYS_TAG="_${name}"
      if [ -n "${ovf}" ]; then export SMC_RETRIEVAL_OVERRIDES_FILE="${ovf}"; fi
      if [ -n "${envs}" ]; then
        IFS=';' read -r -a kvs <<< "${envs}"
        for kv in "${kvs[@]}"; do [ -n "${kv}" ] && export "${kv?}"; done
      fi
      case ";${envs};" in *";XLA_CMDBUF="*) set_xla_flags || exit 1 ;; esac
      build_nsys_wrap
      echo "arm env: overrides=${ovf} out=${outd} solver=${VULCAN_JAX_SOLVER:-default} XLA_FLAGS=${XLA_FLAGS} NSYS=${NSYS:-0}"
      if [ "${mode}" = "probe" ]; then
        ${NSYS_WRAP[@]+"${NSYS_WRAP[@]}"} python -u -m retrieval_framework.probe_memory "${SMC_DIR}"
      elif [ "${mode}" = "bench" ]; then
        GRAD_ARG=""
        if [ "${CALIBRATE_GRAD:-0}" = "1" ]; then GRAD_ARG="--grad"; fi
        ${NSYS_WRAP[@]+"${NSYS_WRAP[@]}"} python -u -m retrieval_framework.calibrate_count_max "${SMC_DIR}" \
          ${CALIBRATE_N_DRAWS:+--n-draws ${CALIBRATE_N_DRAWS}} --fixed-steps "${CALIBRATE_FIXED_STEPS:-150}" ${GRAD_ARG}
      else
        ${NSYS_WRAP[@]+"${NSYS_WRAP[@]}"} python -u -m retrieval_framework.run_smc "${SMC_DIR}" --calibrate
      fi
      wrc=$?
      # job 78814: a windowed nsys returned rc=0 after 3694 s with no timing.json
      # and the orphan's 90% GPU preallocation made every later arm die at
      # gpusolverDnCreate; wait before the next arm touches the GPU.
      wait_for_tree_python
      if [ "${mode}" = "calibrate" ] && [ ! -f "${SMC_DIR}/${outd}/timing.json" ]; then
        echo "arm ${name}: no timing.json in ${outd} -> failed"; exit 1
      fi
      if [ "${mode}" = "bench" ] && ! ls "${SMC_DIR}/${outd}"/bench_fixed_steps*.npz >/dev/null 2>&1; then
        echo "arm ${name}: no bench_fixed_steps npz in ${outd} -> failed"; exit 1
      fi
      exit "${wrc}"
    ) || arm_rc=$?
    printf '%s\t%s\t%s\t%s\t%s\n' "${name}" "${mode}" "${arm_rc}" "$(( $(date +%s) - t0 ))" "${outd}" | tee -a "${CHAIN_TSV}"
    if [ "${arm_rc}" -ne 0 ]; then rc="${arm_rc}"; fi
  done 3< "${CHAIN_FILE}"
  echo "========== CHAIN SUMMARY =========="
  python - "${SMC_DIR}" "${CHAIN_TSV}" <<'PYEOF' || true
import csv, json, pathlib, sys
import numpy as np
smc, tsv = pathlib.Path(sys.argv[1]), sys.argv[2]
for row in csv.DictReader(open(tsv), delimiter="\t"):
    head = f"{row['arm']:<20} rc={row['rc']:<3} {int(row['seconds'])/3600:5.2f} h"
    if row["mode"] == "bench":
        # per accepted step of the slowest lane over the two stages' extra K-1
        # steps each (the gpu preset's two-stage solve), as the bench logs it
        for f in sorted((smc / row["out_dir"]).glob("bench_fixed_steps*.npz")):
            b = np.load(f)
            ms = 1e3 * (float(b["t_steady"]) - float(b["t1_steady"])) / (2 * (int(b["K"]) - 1))
            print(f"{head}  {f.stem}: lanes={b['U'].shape[0]} K={int(b['K'])}"
                  f"  {ms:.1f} ms per accepted step  (K=1 pass {float(b['t1_steady']):.1f} s)")
        continue
    tj = smc / row["out_dir"] / "timing.json"
    t = json.load(open(tj)) if tj.exists() else {}
    print(f"{head}  N={t.get('n_particles','-')} kernel={t.get('smc_mcmc_kernel','-')}"
          f"  t_state_init_s={t.get('t_state_init_s','-')}  t_mutation_sweep_s={t.get('t_mutation_sweep_s','-')}")
PYEOF
elif [ "${CALIBRATE_ONLY:-0}" = "1" ]; then
  echo "========== CALIBRATION ONLY =========="
  ${NSYS_WRAP[@]+"${NSYS_WRAP[@]}"} python -u -m retrieval_framework.run_smc "${SMC_DIR}" --calibrate || rc=$?
  wait_for_tree_python
elif [ "${CALIBRATE_COUNT_MAX:-0}" = "1" ]; then
  # measures the REAL accept_count distribution over CALIBRATE_N_DRAWS prior draws at
  # whatever nz/prior SMC_RETRIEVAL_OVERRIDES_FILE resolves to, at a generous
  # CALIBRATE_COUNT_MAX_PROBE cap so the true tail isn't truncated -- see
  # retrieval_framework/calibrate_count_max.py's docstring. No SMC run happens.
  echo "========== CALIBRATE COUNT_MAX (accept_count distribution only) =========="
  # CALIBRATE_GRAD is a BOOLEAN, tested like the other 0/1 knobs: `:+` would have
  # enabled the gradient bench for CALIBRATE_GRAD=0 too.
  GRAD_ARG=""
  if [ "${CALIBRATE_GRAD:-0}" = "1" ]; then GRAD_ARG="--grad"; fi
  ${NSYS_WRAP[@]+"${NSYS_WRAP[@]}"} python -u -m retrieval_framework.calibrate_count_max "${SMC_DIR}" \
    --n-draws "${CALIBRATE_N_DRAWS:-48}" \
    --count-max-probe "${CALIBRATE_COUNT_MAX_PROBE:-20000}" \
    --seed-offset "${CALIBRATE_SEED_OFFSET:-0}" \
    ${CALIBRATE_LANES:+--lanes ${CALIBRATE_LANES}} \
    ${CALIBRATE_FIXED_STEPS:+--fixed-steps ${CALIBRATE_FIXED_STEPS}} ${GRAD_ARG} || rc=$?
  wait_for_tree_python
elif [ "${SAMPLER:-smc}" = "nautilus" ]; then
  # Nested sampling on the same likelihood (retrieval_framework.run_nautilus):
  # output in <out_dir>_nautilus, stops at the preset's walltime governor and
  # exits 0 unfinished; continue with RESUME=1. No plots or certificate (both
  # read the SMC files).
  echo "========== NAUTILUS RETRIEVAL =========="
  python -u -m retrieval_framework.run_nautilus "${SMC_DIR}" || rc=$?
  wait_for_tree_python
else
  echo "========== SMC RETRIEVAL =========="
  ${NSYS_WRAP[@]+"${NSYS_WRAP[@]}"} python -u -m retrieval_framework.run_smc "${SMC_DIR}" || rc=$?
  wait_for_tree_python
  if [ "${rc}" -eq 0 ]; then
    echo "========== PLOTS =========="
    python -u -m retrieval_framework.plot_smc "${SMC_RETRIEVAL_OUT_DIR:-${SMC_DIR}/data/${SMC_RETRIEVAL_PRESET}}" \
      || echo "WARNING: plotting failed (posterior npz files are still on disk)."
    # Post-run validation. Since 2026-08-03 smc_chem_mode DEFAULTS TO COLD, so
    # these apply to a run that explicitly opted into warm continuation -- and
    # for such a run they are MANDATORY, not advisory.
    #
    # THE VALIDATION RESULT NOW PROPAGATES INTO THE JOB EXIT STATUS. Previously
    # a FAIL or a crash printed a message and the job still exited 0, so a run
    # whose warm bias was above the gate, or never measured at all, ended with a
    # successful-looking production conclusion. The posterior stays on disk
    # either way (it is forensically useful); what changes is that the job no
    # longer claims success for it.
    chem_mode="$(python -c 'import os,sys; sys.path.insert(0,"'"${SMC_DIR}"'");
from retrieval_framework.run_smc import make_config
from pathlib import Path
print(make_config(Path("'"${SMC_DIR}"'"))[0].smc_chem_mode)' 2>/dev/null || echo unknown)"
    echo "========== POST-RUN VALIDATION (chem mode: ${chem_mode}) =========="

    if [ "${chem_mode}" = "warm" ]; then
      # validate_warm exits 0 (PASS), 3 (a REACHED verdict that failed the gate
      # -- validate_warm.npz is on disk), or any other nonzero (CRASHED before a
      # verdict, e.g. an OOM at the batched cold re-solve -- no npz, the bias is
      # UNMEASURED). A crash is NOT a gate FAIL, but it is equally disqualifying
      # for a production certificate: an unmeasured bias is not a passed one.
      vw_rc=0
      python -u -m retrieval_framework.validate_warm "${SMC_DIR}" || vw_rc=$?
      if [ "${vw_rc}" -eq 0 ]; then
        echo "validate_warm: PASS -- warm-continuation bias within the gate (see validate_warm.npz)."
      elif [ "${vw_rc}" -eq 3 ]; then
        echo "ERROR: validate_warm verdict FAIL -- warm-continuation bias above the gate; see validate_warm.npz + log above."
        echo "  This run's posterior and evidence are NOT certified. Re-run with smc_chem_mode='cold' (the default) before reporting numbers."
        rc=3
      else
        echo "ERROR: validate_warm CRASHED (rc=${vw_rc}) before any verdict -- NO validate_warm.npz, the warm-vs-cold bias is UNMEASURED (this is NOT a gate FAIL, but it is not a pass either)."
        echo "  Common cause is a GPU OOM at the cold re-solve on a busy node; rerun standalone on a clean GPU:"
        echo "  SMC_RETRIEVAL_PRESET=${SMC_RETRIEVAL_PRESET} python -m retrieval_framework.validate_warm ${SMC_DIR}"
        echo "  (VALIDATE_WARM_CHUNK=24 lowers the peak further if it recurs.)"
        rc=4
      fi

      # MALA reversibility probe -- also mandatory for a warm run. The warm
      # kernel's forward and reverse proposal densities are evaluated at
      # DIFFERENT carried states, which is exactly the failure mode the
      # likelihood gate above cannot see.
      mr_rc=0
      python -u validation/mala_reversibility.py "${SMC_DIR}" || mr_rc=$?
      if [ "${mr_rc}" -eq 0 ]; then
        echo "mala_reversibility: PASS."
      else
        echo "ERROR: mala_reversibility FAILED or crashed (rc=${mr_rc}) -- the warm MALA kernel's detailed balance is not demonstrated."
        [ "${rc}" -eq 0 ] && rc=5
      fi
    else
      echo "chem mode is '${chem_mode}': the likelihood is the deterministic"
      echo "solve-from-baseline map, so there is no warm-continuation bias to"
      echo "measure. validate_warm / mala_reversibility are warm-only."
    fi

    # PRODUCTION CERTIFICATE. Collects code/data identity, the resolved config,
    # beta=1, target exactness, evidence semantics, run diagnostics, the two
    # production-fidelity artifacts, and a cold replay of a small deterministic
    # subset -- then says PASS or FAIL once. Until this passes, the run's
    # numbers are not certified for reporting.
    echo "========== PRODUCTION CERTIFICATE =========="
    cert_rc=0
    python -u -m retrieval_framework.certificate "${SMC_DIR}" || cert_rc=$?
    if [ "${cert_rc}" -eq 0 ]; then
      echo "certificate: PASS -- see certificate.md / certificate.json."
    else
      echo "ERROR: certificate FAILED (rc=${cert_rc}); see certificate.md for the reasons."
      [ "${rc}" -eq 0 ] && rc=6
    fi
  fi
fi

echo "job finished rc=${rc} at $(date)"
if [ "${rc}" -ne 0 ]; then
  echo "NOT A CERTIFIED PRODUCTION RUN: see the errors above. Artifacts on disk are forensic."
fi
exit "${rc}"
