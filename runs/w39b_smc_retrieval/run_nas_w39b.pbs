#!/bin/bash
#PBS -N VJAX_W39B_NAUTILUS
#PBS -q gpu_long
#PBS -W group_list=s2458
#PBS -l select=1:ncpus=72:ngpus=1:mem=400gb:model=gh200
# 24 h wall: the gpu preset's governor is 20 h, leaving ~4 h for the build and
# compile; an unfinished run checkpoints and exits 0 (resume with RESUME=1).
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -m abe
#
# =============================================================================
# WASP-39b differentiable VULCAN-JAX -> ExoJax transmission retrieval on a
# NASA NAS GH200 node against the real Carter & May (2024) NIRISS+G395H spectrum:
# nested sampling (nautilus).
#
# This job is read-only on the environment: installs live in the one-time
# tools/bootstrap_nas_env.pbs; the preflight only validates
# (retrieval_framework.validate_env) and fails with a pointer to the bootstrap.
#
# Expected layout on /nobackup (git pull for code, scp for data):
#   ${PROJECT_ROOT}/VULCAN-JAX/                                  (chemistry repo)
#   ${PROJECT_ROOT}/vulcan-forward/                               (forward engine)
#   ${PROJECT_ROOT}/vulcan-retrieval/                             (THIS repo; data/ at its root)
#   ${PROJECT_ROOT}/vulcan-retrieval/runs/w39b_smc_retrieval/     (THIS case dir)
#   (the ExoMolOP k-tables and the H2-H2/H2-He CIA live in the repo data/;
#   validate_env names anything missing)
#
# Submit (from this case dir, or export PROJECT_ROOT):
#   cd /nobackup/$USER/VULCAN_W39b_HPC/vulcan-retrieval/runs/w39b_smc_retrieval
#   qsub run_nas_w39b.pbs                        # real-data production run (nautilus, warm starts,
#                                                # 396 lanes, 1188 points per batch)
#   qsub -v RESUME=1 run_nas_w39b.pbs            # continue it in the next job
#   qsub -v NAUTILUS_WARM=0 run_nas_w39b.pbs     # cold nautilus: the order-independent evidence
#   qsub -v SYNTH=1 run_nas_w39b.pbs             # gpu-fidelity synthetic recovery test
#
# Env knobs (-v):
#   CONDA_ENV               interpreter env            (default pyt2_8_gh)
#   SMC_RETRIEVAL_PRESET    smoke | gpu                (default gpu)
#   SMC_RETRIEVAL_OVERRIDES JSON Config overrides      (optional)
#   SMC_RETRIEVAL_OVERRIDES_FILE  JSON Config overrides file, relative to this dir (optional)
#   SEED=<int>              independent seed in its own out_dir (data/<preset>_seed<N>;
#                           nautilus appends _nautilus).
#                           nautilus reports no logZ error: run >= 3 seeds and
#                           quote the seed-to-seed spread. RESUME=1 composes with it.
#   SYNTH=1                 inject-and-recover instead of fitting real data
#   RESUME=1                continue a killed run from its checkpoint (HDF5 file)
#   XLA_CMDBUF=0            command buffers OFF (the empty flag). ON by default;
#                           the commas stay inside the script
#   VULCAN_SCRATCH          cache root                 (default /nobackup/$USER/.vulcan)
#   PROFILE_BATCH=<k>       nautilus only: run under nsys-jax and capture ONE batch, the
#                           k-th likelihood batch of this job (3 = the first steady warm
#                           batch of a fresh run), plus the nautilus update after it
#                           (run_nautilus.BatchProfiler, cudaProfilerApi capture,
#                           --capture-range-end=stop: the run continues unprofiled).
#                           Report: ${PROFILE_DIR}/pipeline_gh200_jax_profile.zip
#                           (default PROFILE_DIR=logs/nsys_<jobid>). nsys writes the
#                           .nsys-rep at the stop, while the run goes on (in nsys-jax's
#                           ${TMPDIR}/tmp*/ dir); nsys-jax archives it when the run exits.
#                           NSYS_JAX (nsys-jax executable), NSYS_BIN (nsys binary),
#                           PROFILE_HLO=1 (off by default) also dumps the HLO protos into
#                           the archive, compiling into an empty JAX cache: ~1.6 GB per
#                           jit_eval_batch proto, ~10 GB in all, lzma-compressed by
#                           nsys-jax in one thread per file at exit (tens of minutes).
#     qsub -v PROFILE_BATCH=3 run_nas_w39b.pbs
#
# BASELINE V4 (overrides/w39b_baseline_v4_nz100.json: the presolve chain, per-group
# noise inflation, 100 layers, 528 lanes), from this case dir, in a fresh out dir:
#   qsub -l walltime=48:00:00 -v SMC_RETRIEVAL_OVERRIDES_FILE=overrides/w39b_baseline_v4_nz100.json,\
#     SMC_RETRIEVAL_OUT_DIR=data/w39b_baseline_v4_nz100,NAUTILUS_N_EFF=5000,\
#     VULCAN3_CHEM_RHS=grouped,PROFILE_BATCH=3 run_nas_w39b.pbs
#   (one line, no spaces after the commas; output in data/w39b_baseline_v4_nz100_nautilus)
# Baseline v2 (job 93269) ran overrides/w39b_baseline_v2.json, kept at tag w39b-baseline-v2.
#
# Figures and the spectrum fit of a finished run:
#   python -m retrieval_framework.nautilus_report <out_dir>   (--spectra 0: no forward model)
#
# Live log:  tail -f <w39b_smc_retrieval>/logs/W39B_NAUTILUS_<jobid>.log
# =============================================================================
set -euo pipefail

# --- locate the project root (PBS spools the script; rely on PBS_O_WORKDIR) ---
if [ -n "${PROJECT_ROOT:-}" ]; then :
elif [ -n "${PBS_O_WORKDIR:-}" ] && [ -d "${PBS_O_WORKDIR}/vulcan-retrieval/runs/w39b_smc_retrieval" ]; then
  PROJECT_ROOT="${PBS_O_WORKDIR}"
elif [ -n "${PBS_O_WORKDIR:-}" ] && [ "$(basename "${PBS_O_WORKDIR}")" = "w39b_smc_retrieval" ]; then
  # case dir -> runs -> repo -> PROJECT_ROOT: three levels up
  PROJECT_ROOT="$(cd -- "${PBS_O_WORKDIR}/../../.." && pwd -P)"
else
  echo "ERROR: set PROJECT_ROOT or submit from .../vulcan-retrieval/runs/w39b_smc_retrieval"
  exit 1
fi
REPO_DIR="${PROJECT_ROOT}/vulcan-retrieval"                            # repo root (data/ lives here)
SMC_DIR="${REPO_DIR}/runs/w39b_smc_retrieval"         # this case
if [ ! -f "${SMC_DIR}/case.py" ] || [ ! -f "${REPO_DIR}/src/retrieval_framework/run_nautilus.py" ]; then
  echo "ERROR: case.py / retrieval framework not found under PROJECT_ROOT=${PROJECT_ROOT}"
  exit 1
fi
export PROJECT_ROOT
export VULCAN_PROJECT_ROOT="${PROJECT_ROOT}"   # makes forward/config.py portable

# --- stream everything to a tail-able log (PBS .o appears only at job end) ----
LOG_DIR="${SMC_DIR}/logs"
mkdir -p "${LOG_DIR}"
_jobid="${PBS_JOBID:-manual_$$}"
LOG_FILE="${LOG_DIR}/W39B_NAUTILUS_${_jobid%%.*}.log"
exec > >(tee -a "${LOG_FILE}") 2>&1
echo "Live log: tail -f ${LOG_FILE}"
echo "Job ${PBS_JOBID:-?} started $(date) on $(hostname) ($(uname -m))"
echo "PROJECT_ROOT=${PROJECT_ROOT}"

# --- caches off $HOME (scratch-rooted, shared with the bootstrap) -------------
: "${VULCAN_SCRATCH:=/nobackup/${USER}/.vulcan}"
export PIP_CACHE_DIR="${VULCAN_SCRATCH}/cache/pip"
export JAX_COMPILATION_CACHE_DIR="${JAX_COMPILATION_CACHE_DIR:-${VULCAN_SCRATCH}/cache/jax}"
# Log every compile and every persistent-cache hit (WARNING level), so a chained
# job's log shows whether it reused the last job's compiles:
# grep "Persistent compilation cache hit" in the second job's log.
export JAX_LOG_COMPILES="${JAX_LOG_COMPILES:-1}"
export XDG_CACHE_HOME="${VULCAN_SCRATCH}/cache/xdg"
export MPLCONFIGDIR="${VULCAN_SCRATCH}/cache/mpl"
export TMPDIR="${VULCAN_SCRATCH}/tmp"
mkdir -p "${PIP_CACHE_DIR}" "${JAX_COMPILATION_CACHE_DIR}" \
         "${XDG_CACHE_HOME}" "${MPLCONFIGDIR}" "${TMPDIR}"

# --- conda env (shared GH200 env; user site populated by the bootstrap) -------
module purge 2>/dev/null || true
module use -a /swbuild/analytix/tools/modulefiles 2>/dev/null || true
module load miniconda3/gh2 2>/dev/null || true
CONDA_BASE="$(conda info --base)"
# shellcheck disable=SC1091
source "${CONDA_BASE}/etc/profile.d/conda.sh"
conda activate "${CONDA_ENV:-pyt2_8_gh}"

# Per-interpreter userbase (matches tools/bootstrap_nas_env.pbs): a shared
# userbase's bin/ is not python-version-scoped.
PYVER="$(python -c 'import sys; print("%d.%d" % sys.version_info[:2])')"
export PYTHONUSERBASE="${VULCAN_SCRATCH}/userbase-py${PYVER}"
unset PYTHONNOUSERSITE

# --- GPU runtime env (validated GH200 knobs from the VULCAN-JAX benchmark) ----
export PYTHONUNBUFFERED=1
export JAX_ENABLE_X64="${JAX_ENABLE_X64:-1}"
unset JAX_PLATFORMS
export JAX_PLATFORM_NAME=gpu
export XLA_PYTHON_CLIENT_PREALLOCATE="${XLA_PYTHON_CLIENT_PREALLOCATE:-true}"
export XLA_PYTHON_CLIENT_MEM_FRACTION="${XLA_PYTHON_CLIENT_MEM_FRACTION:-0.90}"
XLA_BASE_FLAGS="${XLA_FLAGS:---xla_gpu_enable_triton_gemm=false --xla_gpu_autotune_level=0}"
# Command buffers are ON by default; XLA_CMDBUF=0 turns them off for an A/B.
# Off needs the EMPTY value: with no flag at all XLA keeps its own default set.
# The list in 1 REPLACES XLA's default set.
set_xla_flags() {
  case "${XLA_CMDBUF:-1}" in
    0) export XLA_FLAGS="${XLA_BASE_FLAGS} --xla_gpu_enable_command_buffer=" ;;
    1) export XLA_FLAGS="${XLA_BASE_FLAGS} --xla_gpu_enable_command_buffer=FUSION,CUBLAS,CUSTOM_CALL,WHILE" ;;
    *) echo "ERROR: XLA_CMDBUF=${XLA_CMDBUF}: expected 0 or 1"; return 1 ;;
  esac
}
set_xla_flags || exit 1
# Knobs of tools this script does not run: a job that sets one would
# otherwise start a production run.
case "${SAMPLER:-nautilus}" in
  nautilus) ;;
  *) echo "ERROR: SAMPLER=${SAMPLER}: nautilus is the only sampler"; exit 1 ;;
esac
for _v in PROBE_MEMORY CALIBRATE_CHAIN CALIBRATE_ONLY CALIBRATE_COUNT_MAX; do
  if [ -n "${!_v:-}" ] && [ "${!_v}" != "0" ]; then
    echo "ERROR: ${_v} is not supported by this script"; exit 1
  fi
done
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
# Production solver: `ffi`, the CUDA block-Thomas kernel. Pinned here, not left to config_schema.choose_solver(),
# so the job script states the choice and a missing kernel build fails loudly
# instead of falling back to `fast`. `qsub -v VULCAN3_SOLVER=fast` still
# overrides it.
export VULCAN3_SOLVER="${VULCAN3_SOLVER:-ffi}"
# The ffi kernel libraries (CUDA and CPU twins) are per checkout and gitignored (*.so);
# one not built from the checkout's present sources is refused at the first solve
# (vulcan3.solver_fast._register). Build them here when stale (a no-op when current),
# so a pulled kernel change is built in the first minute, not failed hours into the job.
if [ "${VULCAN3_SOLVER}" = "ffi" ]; then
  { env -u JAX_PLATFORM_NAME JAX_PLATFORMS=cpu python -m vulcan3.solver_fast \
    && env -u JAX_PLATFORM_NAME JAX_PLATFORMS=cpu NVCC="${NVCC:-/usr/local/cuda-12.6/bin/nvcc}" NVCC_ARCH="${NVCC_ARCH:-sm_90}" \
         python -m vulcan3.solver_fast --cuda; } || { echo "ERROR: ffi kernel build failed"; exit 1; }
fi
# Opt-in grouped chemistry RHS (VULCAN3_CHEM_RHS=grouped, VULCAN-JAX 3154d6d: bitwise
# on the GH200 ffi path). The target manifest binds it with the solver, so a RESUME
# must keep the value the run started with.
echo "solver: VULCAN3_SOLVER=${VULCAN3_SOLVER} VULCAN3_CHEM_RHS=${VULCAN3_CHEM_RHS:-<unset>}"

# --- preflight: GPU visible, JAX on it, packages + data present ---------------
if ! command -v nvidia-smi >/dev/null 2>&1 || ! nvidia-smi >/dev/null 2>&1; then
  echo "ERROR: no visible NVIDIA GPU in this job."; exit 1
fi
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader

# No installs here: validate only (retrieval_framework.validate_env, shared with
# the bootstrap and runnable by hand on a front end).
python -u -m retrieval_framework.validate_env "${PROJECT_ROOT}" --require-gpu || {
  echo "ERROR: environment validation failed (or retrieval_framework is not installed)."
  echo "       One-time fix, then resubmit:"
  echo "  cd ${REPO_DIR}"
  echo "  qsub tools/bootstrap_nas_env.pbs"
  exit 1
}

# --- GPU utilization monitor ---------------------------------------------------
GPU_MON_LOG="${LOG_DIR}/gpu_monitor_${_jobid%%.*}.log"
( while true; do
    { echo "=== $(date '+%F %T') ==="
      # util%, W, MHz, MiB, MiB -- power+clocks distinguish real work from
      # launch-bound tiny kernels (100% util at ~160W = kernel-launch-bound)
      nvidia-smi --query-gpu=utilization.gpu,power.draw,clocks.sm,memory.used,memory.total --format=csv,noheader,nounits
    } >> "${GPU_MON_LOG}" 2>&1
    sleep 60
  done ) &
GPU_MON_PID=$!
cleanup() { kill "${GPU_MON_PID}" >/dev/null 2>&1 || true; }
trap cleanup EXIT
echo "GPU monitor: ${GPU_MON_LOG}"

# --- retrieval configuration ---------------------------------------------------
export SMC_RETRIEVAL_PRESET="${SMC_RETRIEVAL_PRESET:-gpu}"
if [ "${RESUME:-0}" = "1" ]; then export SMC_RESUME=1; fi
if [ "${SYNTH:-0}" = "1" ] || [ -n "${SEED:-}" ]; then
  # SYNTH: gpu-fidelity synthetic injection/recovery run (do this once before
  # trusting the real-data posterior). SEED: a reproducible draw. Both MERGE
  # into whatever overrides are already set (a bash default cannot hold JSON:
  # its closing brace ends the expansion), and the output directory carries
  # both so synthetic seeds never overwrite each other.
  SMC_RETRIEVAL_OVERRIDES="$(python -c '
import json, os
d = json.loads(os.environ.get("SMC_RETRIEVAL_OVERRIDES") or "{}")
if os.environ.get("SYNTH", "0") == "1":
    d["generate_synthetic_data"] = True
if os.environ.get("SEED"):
    d["seed"] = int(os.environ["SEED"])
print(json.dumps(d))')"
  export SMC_RETRIEVAL_OVERRIDES
  if [ "${SYNTH:-0}" = "1" ]; then _od="${SMC_DIR}/data/gpu_synth"; else _od="${SMC_DIR}/data/${SMC_RETRIEVAL_PRESET}"; fi
  export SMC_RETRIEVAL_OUT_DIR="${SMC_RETRIEVAL_OUT_DIR:-${_od}${SEED:+_seed${SEED}}}"
fi
echo "preset=${SMC_RETRIEVAL_PRESET} overrides=${SMC_RETRIEVAL_OVERRIDES:-<none>}"

cd -P "${REPO_DIR}"   # stable cwd only; retrieval_framework is installed, imports need no cwd

rc=0
# Nested sampling (retrieval_framework.run_nautilus): output in
# <out_dir>_nautilus, stops at the preset's walltime governor and exits 0
# unfinished; continue with RESUME=1. A finished run writes
# nautilus_certificate.json; the figures come from nautilus_report.
echo "========== NAUTILUS RETRIEVAL =========="
NAUT_CMD=(python -u -m retrieval_framework.run_nautilus "${SMC_DIR}")
if [ -n "${PROFILE_BATCH:-}" ]; then
  # One-batch nsys-jax profile (off by default). nsys-jax calls `nsys` from PATH:
  # a one-file bin dir puts the chosen binary first (cuda-12.6's nsys wrapper is
  # not installed on the GH200 nodes). The default nsys-jax is a python3.12 venv:
  #   python3.12 -m venv ${VULCAN_SCRATCH}/tools/nsysjax_venv && .../bin/pip install
  #   "git+https://github.com/NVIDIA/JAX-Toolbox.git@f9d55b6#subdirectory=.github/container/nsys_jax"
  PROFILE_DIR="${PROFILE_DIR:-${LOG_DIR}/nsys_${_jobid%%.*}}"
  NSYS_JAX="${NSYS_JAX:-${VULCAN_SCRATCH}/tools/nsysjax_venv/bin/nsys-jax}"
  NSYS_BIN="${NSYS_BIN:-/opt/nvidia/nsight-systems/2026.3.2/target-linux-sbsa-armv8/nsys}"
  mkdir -p "${PROFILE_DIR}/bin"
  ln -sfn "${NSYS_BIN}" "${PROFILE_DIR}/bin/nsys"
  export PATH="${PROFILE_DIR}/bin:${PATH}"
  echo "profile: batch ${PROFILE_BATCH} -> ${PROFILE_DIR}; nsys $(nsys --version | awk '{print $NF}'); ${NSYS_JAX}"
  if [ "${PROFILE_HLO:-0}" = "1" ]; then
    export JAX_COMPILATION_CACHE_DIR="${PROFILE_DIR}/jax_cache"   # compile, so XLA dumps
    mkdir -p "${JAX_COMPILATION_CACHE_DIR}"
  else
    export XLA_FLAGS="${XLA_FLAGS} --xla_dump_hlo_as_proto=false"   # nsys-jax: no dump
  fi
  # nsys-jax sets -1 (whole tracebacks in the HLO metadata) only when unset; JAX's
  # default keeps the programs, and their cache entries, the production ones
  export JAX_TRACEBACK_IN_LOCATIONS_LIMIT="${JAX_TRACEBACK_IN_LOCATIONS_LIMIT:-10}"
  export VULCAN_PROFILE_BATCH="${PROFILE_BATCH}"
  NAUT_CMD=("${NSYS_JAX}" --trace=cuda,nvtx,osrt --sample=cpu --cpuctxsw=process-tree
            --capture-range=cudaProfilerApi --capture-range-end=stop -f
            --output="${PROFILE_DIR}/pipeline_gh200_jax_profile" --
            "$(command -v python)" -u -m retrieval_framework.run_nautilus "${SMC_DIR}")
fi
"${NAUT_CMD[@]}" || rc=$?
if [ -n "${PROFILE_BATCH:-}" ] && [ -f "${PROFILE_DIR}/pipeline_gh200_jax_profile.zip" ]; then
  # nsys-jax exits 1 when only its source-file gathering failed (no XLA .proto
  # files on the node); the archive is complete then. It prints "Application
  # returned unexpected code" when the run itself failed: then rc stands.
  echo "profile: ${PROFILE_DIR}/pipeline_gh200_jax_profile.zip written"
  [ "${rc}" -eq 1 ] && ! grep -q "Application returned unexpected code" "${LOG_FILE}" && rc=0
fi
echo "job finished rc=${rc} at $(date)"
if [ "${rc}" -ne 0 ]; then
  echo "NOT A CERTIFIED PRODUCTION RUN: see the errors above. Artifacts on disk are forensic."
fi
exit "${rc}"
