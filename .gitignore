# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.DS_Store



# Opacity caches (CIA tables) and the ExoMolOP k-tables (~389 MB/species;
# python -m vulcan_forward.fetch_exomolop). Regenerable, 6+ GB total; note
# data/*.npz below does NOT match files inside these subdirectories.
data/opacity_cache/
data/exomolop/

# Run outputs (posteriors, checkpoints, logs, PBS job logs) -- regenerated per run
# ** so a nested run dir (a repo-root-relative SMC_RETRIEVAL_OUT_DIR
# resolved against the run dir) is matched too
runs/**/data/
runs/**/logs/
runs/**/plots/
runs/*/*.o[0-9]*

# Generated npz caches: regenerable and easy to leave stale in git; never track them.
data/*.npz

# Editor / OS noise
.vscode/
.idea/

# Packaging build artifacts (pip install -e .)
*.egg-info/
build/
dist/

# Generated artifacts: run outputs, logs and validation results, output/<case>/...
# (run_setup.output_base). The legacy runs/**/data|logs|plots and
# validation/results rules above and below keep old local trees ignored.
/output/
validation/results/

# One-off scripts, tests and figures made on top of the code: never tracked.
/scratch/

# vulcan3 figures (plot_dir): never tracked.
/plot/
