# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.DS_Store

# Internal working documents. docs/ carries the published reference set
# (forward_model, gradients_and_sampler, wasp39b_case, limitations, validation).
# Everything below is a narrative development log or an incident post-mortem:
# kept locally, not shipped to consumers. data/notes.md is deliberately NOT here
# -- it is observation provenance and regeneration policy, which consumers need.
CLAUDE.md
/notes.md
docs/failed_approaches.md
docs/job65815_badgrad_investigation.md
examples/notes.md
runs/*/notes.md
scripts/zco_information/notes.md
validation/notes.md

# One-off diagnostic scripts from closed investigations. validation/ ships the
# reusable smokes and the audit-response suite; these are not reusable.
validation/badgrad_65815/
validation/diag_*.py

# Large opacity/line-list caches -- NOT tracked. ExoJax downloads HITRAN line lists
# and CIA tables on first use (via the NAS proxy on HPC; see run_nas_w39b.pbs), and
# the ExoMol CO cache regenerates the same way. Total ~360 MB that git should not carry.
data/exojax_linelists/
data/opacity_cache/

# Run outputs (posteriors, checkpoints, logs, PBS job logs) -- regenerated per run
runs/*/data/
runs/*/logs/
runs/*/plots/
runs/*/*.o[0-9]*
*.nsys-rep

# Generated npz caches (sensitivity/zco jacobians/walk) -- scientifically versioned
# by the code that writes them, regenerable, and easy to leave stale in git (the
# tracked set was deleted as stale 2026-07-11); never re-track them.
data/*.npz

# Editor / OS noise
.vscode/
.idea/

# Packaging build artifacts (pip install -e .)
*.egg-info/
build/
dist/

# jwst_tool runtime caches (model spectra + pandeia results) -- regenerated per run
data/jwst_tool/model_cache/
data/jwst_tool/noise_cache/

# Generated outputs (example/validation/zco npz caches) -- config.OUTPUTS
output/*
!output/.gitkeep
