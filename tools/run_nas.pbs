#!/bin/bash
#PBS -j oe
#PBS -m abe
#
# =============================================================================
# One nautilus retrieval run on a NASA NAS GH200 node, from a run specification
# (runs/<case>/<name>.yaml). Submit through tools/submit.py, not qsub by hand:
#
#   python tools/submit.py runs/w39b_smc_retrieval/wasp39_test1.yaml [--resume] [--dry-run]
#
# submit.py validates the spec, puts the job (queue, the allocation in $PBS_GROUP,
# select line, a walltime past the spec's governor), the run name and the log
# directory on the qsub command line (nothing run- or user-specific lives up here)
# and passes four comma-free values:
#   VR_SPEC         the spec file (absolute)
#   VR_SPEC_DIGEST  its run_setup.spec_digest at submission: an edited spec is refused
#   VR_OUT          the run's output directory, output/<case>/<name>_nautilus (absolute)
#   VR_RESUME       0 fresh run, 1 continue the checkpoint in VR_OUT
# The spec's runtime block (VULCAN3_SOLVER, VULCAN3_CHEM_RHS, VULCAN3_BT_BUFFERS,
# XLA_PYTHON_CLIENT_MEM_FRACTION, XLA_FLAGS) is exported below through
# retrieval_framework.run_setup, so the kernel build, the preflight and the run see
# one environment. This job is read-only on that environment: installs live in
# tools/bootstrap_nas_env.pbs; the preflight only validates
# (retrieval_framework.validate_env) and fails with a pointer to the bootstrap.
#
# Layout on /nobackup (PBS_O_WORKDIR is this repo's root: submit.py runs qsub there):
#   ${PROJECT_ROOT}/VULCAN-JAX/   ${PROJECT_ROOT}/vulcan-forward/   ${PROJECT_ROOT}/vulcan-retrieval/
#
# Infrastructure knobs, passed through by submit.py when set in its shell:
#   CONDA_ENV        interpreter env (default pyt2_8_gh)
#   VULCAN_SCRATCH   cache root (default /nobackup/$USER/.vulcan)
# Profiling is not part of this job (notes "HPC (NAS GH200) and daw", profiling).
#
# Live log:  tail -f <out_dir>/jobs/<jobid>.log   (the PBS .OU lands beside it at job end)
# After a finished run: python -m retrieval_framework.nautilus_report <out_dir> [--spectra N]
# =============================================================================
set -euo pipefail

: "${VR_SPEC:?submit through tools/submit.py}"
: "${VR_SPEC_DIGEST:?submit through tools/submit.py}"
: "${VR_OUT:?submit through tools/submit.py}"
: "${VR_RESUME:=0}"
REPO_DIR="$(cd -- "${PBS_O_WORKDIR:?}" && pwd -P)"
if [ ! -f "${REPO_DIR}/src/retrieval_framework/run_nautilus.py" ]; then
  echo "ERROR: PBS_O_WORKDIR=${REPO_DIR} is not the vulcan-retrieval root (submit through tools/submit.py)"
  exit 1
fi
cd -P "${REPO_DIR}"   # the job's working directory: the spec's relative paths resolve here
PROJECT_ROOT="$(dirname "${REPO_DIR}")"
export PROJECT_ROOT
export VULCAN_PROJECT_ROOT="${PROJECT_ROOT}"   # makes forward/config.py portable

# --- live log in the run's directory (PBS's own .OU appears only at job end) ---
JOB_DIR="${VR_OUT}/jobs"
mkdir -p "${JOB_DIR}"
_jobid="${PBS_JOBID:-manual_$$}"; _jobid="${_jobid%%.*}"
LOG_FILE="${JOB_DIR}/${_jobid}.log"
exec > >(tee -a "${LOG_FILE}") 2>&1
echo "Live log: tail -f ${LOG_FILE}"
echo "Job ${PBS_JOBID:-?} started $(date) on $(hostname) ($(uname -m))"
echo "spec=${VR_SPEC} out=${VR_OUT} resume=${VR_RESUME} PROJECT_ROOT=${PROJECT_ROOT}"

# --- caches off $HOME (scratch-rooted, shared with the bootstrap) -------------
: "${VULCAN_SCRATCH:=/nobackup/${USER}/.vulcan}"
export PIP_CACHE_DIR="${VULCAN_SCRATCH}/cache/pip"
export JAX_COMPILATION_CACHE_DIR="${JAX_COMPILATION_CACHE_DIR:-${VULCAN_SCRATCH}/cache/jax}"
# Log every compile and every persistent-cache hit, so a chained job's log shows
# whether it reused the last job's compiles (grep "Persistent compilation cache hit").
export JAX_LOG_COMPILES="${JAX_LOG_COMPILES:-1}"
export XDG_CACHE_HOME="${VULCAN_SCRATCH}/cache/xdg"
export MPLCONFIGDIR="${VULCAN_SCRATCH}/cache/mpl"
export TMPDIR="${VULCAN_SCRATCH}/tmp"
mkdir -p "${PIP_CACHE_DIR}" "${JAX_COMPILATION_CACHE_DIR}" \
         "${XDG_CACHE_HOME}" "${MPLCONFIGDIR}" "${TMPDIR}"

# --- conda env (shared GH200 env; user site populated by the bootstrap) -------
set +u   # the module scripts read unset variables; a failing module command still stops the job
module purge
module use -a /swbuild/analytix/tools/modulefiles
module load miniconda3/gh2
set -u
CONDA_BASE="$(conda info --base)"
# shellcheck disable=SC1091
source "${CONDA_BASE}/etc/profile.d/conda.sh"
conda activate "${CONDA_ENV:-pyt2_8_gh}"

# Per-interpreter userbase (matches tools/bootstrap_nas_env.pbs): a shared
# userbase's bin/ is not python-version-scoped.
PYVER="$(python -c 'import sys; print("%d.%d" % sys.version_info[:2])')"
export PYTHONUSERBASE="${VULCAN_SCRATCH}/userbase-py${PYVER}"
unset PYTHONNOUSERSITE

# --- fixed process settings (the run-specific ones are the spec's runtime block) ---
export PYTHONUNBUFFERED=1
export JAX_ENABLE_X64=1
unset JAX_PLATFORMS
export JAX_PLATFORM_NAME=gpu
export XLA_PYTHON_CLIENT_PREALLOCATE=true
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"

# --- the spec's runtime block, exported before any vulcan3 or jax import ------
RUNTIME_EXPORTS="$(python -m retrieval_framework.run_setup "${VR_SPEC}" --digest "${VR_SPEC_DIGEST}")" || {
  echo "ERROR: the spec ${VR_SPEC} did not load or changed after submission (see above)"; exit 1; }
eval "${RUNTIME_EXPORTS}"
echo "runtime: VULCAN3_SOLVER=${VULCAN3_SOLVER} VULCAN3_CHEM_RHS=${VULCAN3_CHEM_RHS}" \
     "VULCAN3_BT_BUFFERS=${VULCAN3_BT_BUFFERS:-<unset>} XLA_PYTHON_CLIENT_MEM_FRACTION=${XLA_PYTHON_CLIENT_MEM_FRACTION:-<unset>}"
echo "XLA_FLAGS=${XLA_FLAGS:-<unset>}"

# The ffi kernel libraries (CUDA and CPU twins) are per checkout and gitignored (*.so);
# one not built from the checkout's present sources is refused at the first solve
# (vulcan3.solver_fast._register). Build them here when stale (a no-op when current),
# so a pulled kernel change is built in the first minute, not failed hours into the job.
if [ "${VULCAN3_SOLVER}" = "ffi" ]; then
  { env -u JAX_PLATFORM_NAME JAX_PLATFORMS=cpu python -m vulcan3.solver_fast \
    && env -u JAX_PLATFORM_NAME JAX_PLATFORMS=cpu NVCC="${NVCC:-/usr/local/cuda-12.6/bin/nvcc}" NVCC_ARCH="${NVCC_ARCH:-sm_90}" \
         python -m vulcan3.solver_fast --cuda; } || { echo "ERROR: ffi kernel build failed"; exit 1; }
fi

# --- preflight: GPU visible, JAX on it, packages + data present ---------------
if ! command -v nvidia-smi >/dev/null 2>&1 || ! nvidia-smi >/dev/null 2>&1; then
  echo "ERROR: no visible NVIDIA GPU in this job."; exit 1
fi
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
# No installs here: validate only (shared with the bootstrap; runnable on a front end).
python -u -m retrieval_framework.validate_env "${PROJECT_ROOT}" --require-gpu --spec "${VR_SPEC}" || {
  echo "ERROR: environment validation failed (or retrieval_framework is not installed)."
  echo "       One-time fix, then resubmit:"
  echo "  cd ${REPO_DIR}"
  echo "  qsub -W group_list=\$PBS_GROUP tools/bootstrap_nas_env.pbs"
  exit 1
}

# --- GPU utilization monitor ---------------------------------------------------
GPU_MON_LOG="${JOB_DIR}/gpu_monitor_${_jobid}.log"
( while true; do
    { echo "=== $(date '+%F %T') ==="
      # util%, W, MHz, MiB, MiB: power and clocks tell real work from launch-bound tiny kernels
      nvidia-smi --query-gpu=utilization.gpu,power.draw,clocks.sm,memory.used,memory.total --format=csv,noheader,nounits
    } >> "${GPU_MON_LOG}" 2>&1
    sleep 60
  done ) &
GPU_MON_PID=$!
cleanup() { kill "${GPU_MON_PID}" >/dev/null 2>&1 || true; }
trap cleanup EXIT
echo "GPU monitor: ${GPU_MON_LOG}"

rc=0
echo "========== NAUTILUS RETRIEVAL =========="
NAUT_CMD=(python -u -m retrieval_framework.run_nautilus "${VR_SPEC}")
if [ "${VR_RESUME}" = "1" ]; then NAUT_CMD+=(--resume); fi
"${NAUT_CMD[@]}" || rc=$?
echo "job finished rc=${rc} at $(date)"
if [ "${rc}" -ne 0 ]; then
  echo "NOT A CERTIFIED PRODUCTION RUN: see the errors above. Artifacts on disk are forensic."
fi
exit "${rc}"
